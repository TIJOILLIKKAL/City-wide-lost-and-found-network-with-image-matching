# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-min-50-chars-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# In Docker: use service name "db". Outside Docker: use "localhost"
DB_NAME=lostfound_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ── MongoDB ───────────────────────────────────────────────────────────────────
# In Docker: use service name "mongo". Outside Docker: use "localhost"
MONGO_URI=mongodb://mongo:27017/
MONGO_DB_NAME=lostfound_items

# ── Redis ─────────────────────────────────────────────────────────────────────
# In Docker: use service name "redis". Outside Docker: use "localhost"
REDIS_URL=redis://redis:6379/0

# ── Elasticsearch ─────────────────────────────────────────────────────────────
# In Docker: use service name "elasticsearch". Outside Docker: use "localhost"
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme

# ── AWS S3 (image storage) ────────────────────────────────────────────────────
# Leave empty to use local filesystem storage (development only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=lostfound-media
AWS_S3_REGION_NAME=ap-south-1

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
